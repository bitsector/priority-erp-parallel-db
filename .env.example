# Copy to .env (never commit .env) and fill in the Supabase values.

# Priority public demo sandbox (published in the Priority REST API docs)
PRIORITY_SANDBOX_URL="https://t.eu.priority-connect.online/odata/Priority/tabbtd38.ini/usdemo"
PRIORITY_SANDBOX_USER="apidemo"
PRIORITY_SANDBOX_PASS="123"

# Supabase Management API, used by 02_load_snapshot.py
SUPABASE_PROJECT_REF="<project-ref>"     # from your project's URL: https://<project-ref>.supabase.co
SUPABASE_PROJECT_TOKEN="sbp_..."         # Dashboard > Account > Access Tokens. Revoke it when you're done.

# Optional knobs for 02_load_snapshot.py (defaults shown)
# MAX_ROWS=400      records per form
# PAGE=100          records per Priority request
# BATCH_ROWS=100    rows per Supabase insert
# SLEEP=0.7         seconds between Priority requests (Priority allows 100 calls/min)
